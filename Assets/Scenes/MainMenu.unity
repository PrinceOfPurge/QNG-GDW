  m_Name: 
  m_EditorClassIdentifier: 
  consoleCam: {fileID: 228558556}
  roadOverviewCam: {fileID: 1937531496}
  signGlanceCam: {fileID: 1361200791}
  signController: {fileID: 1167562012}
  treeSpawner: {fileID: 997849976}
  glanceDuration: 2.5
  zombieJumpScare: {fileID: 878289683}
  delayBeforeJumpScare: 1
  subtitleTextUI: {fileID: 1004047079}
  subtitleCanvasGroup: {fileID: 452319694}
  textFadeSpeed: 3
  dialogueLines:
  - speakerName: Officer Jackson
    lineText: Unit 2-Alpha to Control, or any unit near the square.
    displayDuration: 3
    delayBeforeNext: 0.5
    audioEvent:
      Guid:
        Data1: 2097094115
        Data2: 1269240438
        Data3: 1652605110
        Data4: 713081632
      Path: event:/Dialogue/Jackson/Jackson
  - speakerName: Bailey Morgan
    lineText: This is 3-Bravo, go ahead 2-Alpha.
    displayDuration: 2
    delayBeforeNext: 0.5
    audioEvent:
      Guid:
        Data1: -926084787
        Data2: 1209322946
        Data3: -850918528
        Data4: 1030053675
      Path: event:/Dialogue/Morgan/Morgan
  - speakerName: Officer Jackson
    lineText: 3-Bravo, we have a code 10-54 out here. Heavy localized fog, citizens
      unaccounted for. Requesting immediate backup at the city square.
    displayDuration: 10
    delayBeforeNext: 0.5
    audioEvent:
      Guid:
        Data1: 1380835077
        Data2: 1110775144
        Data3: 785610911
        Data4: 97909291
      Path: event:/Dialogue/Jackson/Jackson 2
  - speakerName: Bailey Morgan
    lineText: Copy that... did you say fog? Give me a break, Alpha.
    displayDuration: 3
    delayBeforeNext: 0.5
    audioEvent:
      Guid:
        Data1: -20227747
        Data2: 1321582523
        Data3: -9984883
        Data4: -970641470
      Path: event:/Dialogue/Morgan/Morgan 2
  - speakerName: Officer Jackson
    lineText: HELP!!!
    displayDuration: 2.5
    delayBeforeNext: 0.5
    audioEvent:
      Guid:
        Data1: 1253350005
        Data2: 1300585067
        Data3: -1354293334
        Data4: -1413699056
      Path: event:/Dialogue/Jackson/Jackson 5
